# Install as /etc/hoolan/env with mode 0600. Set real random secrets.
HOOLAN_TOKEN=replace-with-a-long-random-token
HOOLAN_CLASH_SECRET=replace-with-a-different-random-token
# Optional initial subscriptions; browser-added subscriptions persist in state.
# HOOLAN_SUBS=https://provider.example/subscription

# Optional Docker inventory socket; empty disables the Containers panel's discovery.
# HOOLAN_DOCKER_SOCKET=/var/run/docker.sock
