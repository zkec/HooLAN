# Install as /etc/proxy-manager/env with mode 0600. Set real random secrets.
PROXY_MANAGER_TOKEN=replace-with-a-long-random-token
PROXY_MANAGER_CLASH_SECRET=replace-with-a-different-random-token
# Optional initial subscriptions; browser-added subscriptions persist in state.
# PROXY_MANAGER_SUBS=https://provider.example/subscription
