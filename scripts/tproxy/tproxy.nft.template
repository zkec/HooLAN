#!/usr/sbin/nft -f
#
# GENERATED FILE -- DO NOT EDIT.
# Source: scripts/tproxy/tproxy.nft.template + scripts/tproxy/tproxy.conf
# Renderer: scripts/tproxy/apply.sh
#
# Smart Gateway TPROXY interception for sing-box, on a Pi that also hosts a
# Docker stack (NPM / AdGuard Home / wg-easy / Jellyfin).
#
# IPv4 only. IPv6 LAN interception is a deliberate omission for now — clients
# should get no IPv6 connectivity while this gateway is active, otherwise they
# will leak around sing-box.
#
# Hook priority: `mangle` == -150, i.e. we run BEFORE Docker's iptables-nft
# DNAT chains at -100 (PREROUTING) and DNAT at -100 (OUTPUT). That ordering is
# what makes the `fib daddr type local` bypass work: at -150 the destination
# address is still the original one (NPM on 80/443, AdGuard on 53, ...), not
# whatever docker-proxy will rewrite it to later.
#
# DOCKER COEXISTENCE. This file creates no iptables rules, touches no
# DOCKER-USER chain, and claims no chain name Docker uses. nft and iptables-nft
# share one kernel ruleset per hook; Docker's own rules run after ours and are
# left entirely alone.

# One nft transaction replaces our table AND sets. `add` is idempotent;
# the following delete also works on first installation. Never flush ruleset.
add table inet proxy_tproxy
delete table inet proxy_tproxy
table inet proxy_tproxy {
    comment "TPROXY interception for sing-box (smart gateway)"

    # The Pi's own LAN subnet(s), computed by apply.sh from live addresses on
    # LAN_IF (NOT a hardcoded /24). Traffic destined inside the Pi's own subnet
    # never leaves the LAN and must not be intercepted: Jellyfin on :8096,
    # aria2 on :6800, NPM healthchecks, mDNS, the lot.
    set lan_cidrs {
        type ipv4_addr
        flags interval
        elements = { {{LAN_CIDR_LIST}} }
    }

    # Source prefixes exempt from interception (the Pi's own outbound if you
    # choose to proxy it later — see SELF_ORIGIN_NETS in tproxy.conf).
    set self_origin {
        type ipv4_addr
        flags interval
        elements = { {{SELF_ORIGIN_LIST}} }
    }

    # Destinations that must reach the real internet or local stack, never
    # sing-box. Includes RFC1918 wholesale, which covers the Docker bridge
    # (172.17.0.0/16) and wg-easy's WireGuard subnet (10.42.42.0/24).
    set bypass_daddrs {
        type ipv4_addr
        flags interval
        elements = {
            0.0.0.0/8,          # this-network / "unspecified"
            100.64.0.0/10,      # CGNAT: Tailscale, some ISP DS-Lite tunnels
            127.0.0.0/8,        # loopback
            169.254.0.0/16,     # link-local, SSDP discovery
            172.16.0.0/12,      # RFC1918 -- Docker bridges, overlays
            192.168.0.0/16,     # RFC1918
            10.0.0.0/8,         # RFC1918 -- covers wg-easy 10.42.42.0/24
            224.0.0.0/4,        # multicast
            240.0.0.0/4         # reserved / broadcast
        }
    }

    # Named counters make socket lookup failures visible without packet tracing.
    counter lan_packets {}
    counter bypass_local {}
    counter bypass_private {}
    counter bypass_source {}
    counter tproxy_attempt_tcp {}
    counter tproxy_assigned_tcp {}
    counter tproxy_failed_tcp {}
    counter tproxy_attempt_udp {}
    counter tproxy_assigned_udp {}
    counter tproxy_failed_udp {}
    counter marked_input {}
    counter marked_output {}

    {{BALANCE_CHAINS}}

    chain prerouting {
        type filter hook prerouting priority mangle; policy accept;
        comment "sing-box TPROXY interception (LAN clients)"

        # Intercept only the interface configured as facing LAN clients.
        # Docker ingress is explicitly exempt even if LAN_IF is misconfigured.
        iifname { "lo", "docker0", "br-*", "veth*" } accept
        iifname != "{{LAN_IF}}" accept
        meta nfproto != ipv4 accept
        counter name lan_packets

        # Preserve host services (including published Docker ports 80/443/53)
        # BEFORE Docker DNAT at -100 changes their destination. Protect every
        # local destination, not just today's published port list.
        fib daddr type { local, broadcast, multicast } counter name bypass_local accept
        ip daddr @lan_cidrs counter name bypass_private accept
        ip daddr 10.42.42.0/24 counter name bypass_private accept
        ip daddr @bypass_daddrs counter name bypass_private accept
        ip saddr @self_origin counter name bypass_source accept
        ip saddr { 127.0.0.0/8, 0.0.0.0/32 } counter name bypass_source accept

        jump balance_dispatch

        # Every client packet, including established TCP ACK/data and UDP
        # replies within a flow, must be assigned to its transparent socket.
        # A packet mark is NOT inherited automatically from conntrack.
        # nft TPROXY aborts the current rule (NFT_BREAK) on lookup failure.
        # Set the routing mark AFTER successful assignment: marking first
        # blackholes failures in the local-route table with no usable socket.
        meta l4proto tcp counter name tproxy_attempt_tcp
        meta l4proto tcp tproxy ip to :{{TPROXY_PORT}} meta mark set {{TPROXY_FWMARK}} counter name tproxy_assigned_tcp accept
        meta l4proto tcp counter name tproxy_failed_tcp
        meta l4proto udp counter name tproxy_attempt_udp
        meta l4proto udp tproxy ip to :{{TPROXY_PORT}} meta mark set {{TPROXY_FWMARK}} counter name tproxy_assigned_udp accept
        meta l4proto udp counter name tproxy_failed_udp

        # A failed lookup falls back to ordinary forwarding. Only clear our
        # exact reserved mark if it was already present on ingress; preserve
        # unrelated marks. Fallback needs the site's normal forwarding/NAT.
        meta l4proto { tcp, udp } meta mark {{TPROXY_FWMARK}} meta mark set 0
    }

    # Observation only. Reaching INPUT proves the marked packet was routed
    # locally, but another INPUT base chain can still reject it afterwards.
    chain input {
        type filter hook input priority mangle; policy accept;
        meta nfproto ipv4 meta mark {{TPROXY_FWMARK}} counter name marked_input
    }

    # The Pi and sing-box generate ordinary outbound sockets; they must use
    # the host's main routing table. A nonzero count here calls for checking
    # outbound routing_mark, tcp_fwmark_accept, and other marking rules.
    chain output {
        type filter hook output priority mangle; policy accept;
        meta nfproto ipv4 meta mark {{TPROXY_FWMARK}} counter name marked_output
    }

    # No NAT is required for sing-box's newly created, locally sourced
    # outbound sockets. Site-specific NAT for BYPASSED/forwarded LAN traffic
    # belongs to the host/router's existing firewall configuration.
}

# Generated QoS table, submitted atomically with interception.
# An independent table keeps device limits active when interception is removed.
# Four-way per-device policing lives in inet proxy_qos and survives proxy OFF.
# Its upload hook runs at -149, AFTER the -150 TPROXY verdict, before userspace.
# Mark {{TPROXY_FWMARK}} means intercepted, not necessarily proxied: actual
# direct/Iran versus proxy decisions arrive via expiring Clash tuple sets.
# Download policing runs at postrouting 99 (before SNAT), matching client daddr.
{{QOS_TABLE}}
